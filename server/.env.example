PORT=5000

# Optionnel : un token GitHub (sans aucune permission) relève la limite de 60 à 5 000 requêtes/heure
GITHUB_TOKEN=
CLIENT_ORIGIN=http://localhost:5173

# Optionnel : pour recevoir les messages du formulaire par email
# (exemple Gmail : crée un "mot de passe d'application" dans ton compte Google)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# Back-office (/admin) : sans mot de passe, le back-office est désactivé
ADMIN_PASSWORD=
# Clé de signature des sessions (une longue chaîne aléatoire). Sans elle, les sessions expirent à chaque redémarrage.
ADMIN_SECRET=
